// Prisma schema for Cozy Appetizer Shop
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String?
  role                String    @default("customer")
  emailVerified       Boolean   @default(false)
  otpCode             String?
  otpExpiresAt        DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  provider            String    @default("credentials")
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  backupCodes         String[]  @default([])
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  cart                Json?
  createdAt           DateTime  @default(now())
  orders              Order[]
  sessions            UserSession[]
  addresses           Address[]
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Home")
  fullName   String
  phone      String
  street     String
  area       String
  city       String
  postalCode String?
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  costPrice   Float       @default(0)
  images      String[]
  category    String
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  email          String
  status         String      @default("pending")
  paymentMethod  String
  paymentStatus  String      @default("unpaid")
  subtotal       Float
  deliveryCharge Float       @default(0)
  total          Float
  deliveryArea   String
  address        Json
  notes          String?
  paymentRef     String?
  discount       Float       @default(0)
  couponCode     String?
  tax            Float       @default(0)
  invoiceNumber  Int?
  refundStatus   String      @default("none")
  refundedAmount Float       @default(0)
  refundedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  user           User?       @relation(fields: [userId], references: [id])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  costPrice Float   @default(0)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model DeliveryZone {
  id            String   @id @default(cuid())
  name          String
  country       String   @default("")
  state         String   @default("")
  wholeCountry  Boolean  @default(false)
  areas         String[]
  charge        Float
  estimatedDays String
  active        Boolean  @default(true)
  freeAbove     Float?
  sortOrder     Int      @default(0)
}

model Settings {
  id                String  @id @default("singleton")
  storeName         String  @default("My Cozy Shop")
  storeEmail        String  @default("")
  adminEmail        String  @default("")
  currency          String  @default("USD")
  currencySymbol    String  @default("$")
  stripeSecretKey   String  @default("")
  paypalClientId    String  @default("")
  adminPath         String  @default("admin-panel")
  freeDeliveryAbove Float?
  faviconUrl        String  @default("")
  googleAuthEnabled Boolean @default(false)
  googleClientId    String  @default("")
  googleClientSecret String @default("")
  smtpHost          String  @default("")
  smtpPort          Int?
  smtpUser          String  @default("")
  smtpPassword      String  @default("")
  smtpFrom          String  @default("")
  smtpSecure        Boolean @default(false)
  codEnabled        Boolean @default(true)
  stripeEnabled     Boolean @default(false)
  paypalEnabled     Boolean @default(false)
  paymentSandbox    Boolean @default(true)
  stripePublishableKey String @default("")
  stripeWebhookSecret  String @default("")
  paypalClientSecret   String @default("")
  aboutTitle        String  @default("")
  aboutBody         String  @default("")
  invoicePrefix     String  @default("INV-")
  nextInvoiceNumber Int     @default(1)
  taxEnabled        Boolean @default(false)
  taxRate           Float   @default(0)
  taxLabel          String  @default("VAT")
  taxInclusive      Boolean @default(false)
  reviewsEnabled    Boolean @default(true)
  reviewAutoApprove Boolean @default(false)
  brandName         String  @default("Creamy")
  heroHeading       String  @default("Taste Joy in Every Bite")
  heroSlides        Json?
  faqs              Json?
  footerAddress     String  @default("")
  footerPhone       String  @default("")
  footerEmail       String  @default("")
  footerHours       String  @default("")
  socialInstagram   String  @default("")
  socialFacebook    String  @default("")
  socialTwitter     String  @default("")
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  comment    String   @default("")
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("percent")
  value       Float
  active      Boolean   @default(true)
  minSubtotal Float     @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  quote     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
